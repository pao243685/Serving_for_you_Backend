# Copia este archivo a /opt/sfy/.env en la EC2 del backend y llena los valores.
# NUNCA lo subas al repositorio.
#
# Genera contraseñas seguras con:  openssl rand -hex 24

DOCKERHUB_USER=tu_usuario_de_dockerhub   # el pipeline lo actualiza en cada despliegue
BACKEND_TAG=latest            # lo actualiza deploy.sh en cada despliegue

POSTGRES_PASSWORD=
APP_BACKEND_PASSWORD=

JWT_SECRET=                   # openssl rand -hex 32
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos (separados por coma): el dominio del front y el de la API (Swagger)
ALLOWED_ORIGINS=https://serving-for-u.duckdns.org,https://serving-for-u-back.duckdns.org

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# /docs y /redoc (Swagger). false para ocultarlos
DOCS_ENABLED=true
ZONA_HORARIA_HORAS=-6

# Bucket de S3 para respaldos (déjalo vacío para no respaldar)
S3_BUCKET=
